{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "target": "ESNext",
    "lib": ["ES2021", "dom"],
    "module": "ESNext",
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "#/server/*": ["./src/*"],
      "#/*": ["../src/*"]
    },
    "noEmit": true
  },
  "include": ["src"]
}
